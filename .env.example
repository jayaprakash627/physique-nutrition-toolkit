# Copy to .env (which is gitignored) or set these in your host's environment.
# NEVER commit real values.

# Required for Coach mode. Without it, the calculator still works but every
# client-data endpoint returns 503 — a missing setting must not mean an open door.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
COACH_PASSWORD=

# ---------------------------------------------------------------------------
# Where client data lives
# ---------------------------------------------------------------------------
#
# Unset  → SQLite, one local file. Local development and the test suite.
# Set    → PostgreSQL. What the deployed app must use.
#
# This is not a preference. The app is deployed on a host with an ephemeral
# disk: a SQLite file there is deleted on every redeploy and every idle
# spin-down. That was acceptable for a public demo. It is data loss once real
# clients are in it.
#
# Neon (neon.tech) free tier. Use the **pooled** connection string — the one
# whose host contains "-pooler" — and keep ?sslmode=require on the end.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Where the SQLite file lives, when DATABASE_URL is unset. Local development
# only — this does nothing once DATABASE_URL is set.
# TOOLKIT_DB=/var/data/toolkit.db

# Force the Secure flag on the session cookie. Only needed if your proxy
# terminates TLS without setting X-Forwarded-Proto.
# PNT_FORCE_SECURE_COOKIE=1
